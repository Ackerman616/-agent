# OpenAI-compatible model endpoint. DeepSeek is the default example.
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=Please paste your model API key here
MODEL_NAME=deepseek-v4-flash

# Apply for a WebService API key at Tencent Location Service:
# https://lbs.qq.com/dev/console/application/mine
TENCENT_MAP_KEY=Please paste your Tencent Map WebService key here

PORT=8787
MAX_SEARCH_REQUESTS=8
MAX_ROUTE_REQUESTS=30
